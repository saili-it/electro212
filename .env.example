# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electro212?schema=public"
# Separate database used only by the integration test suite — never the dev DB above.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/electro212_test?schema=public"

# Auth.js (NextAuth v5) session encryption secret — generate with `npx auth secret`
AUTH_SECRET=""

# Image storage. STORAGE_DRIVER: "s3" (bucket below) or "local" (disk under .data/uploads,
# only for dev or a server with a persistent volume). Unset: s3 if configured, local in dev.
STORAGE_DRIVER=""
# S3-compatible bucket (AWS S3, Cloudflare R2...) for uploaded images
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_CDN_URL=""

# Shared secret required on the internal cron endpoint (release-stale-reservations)
CRON_SECRET=""

# Public site URL (canonical links, Open Graph, sitemap)
SITE_URL="http://localhost:3000"
